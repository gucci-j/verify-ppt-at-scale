+++ b/examples/smollm3/convert_hf_to_nanotron.py
@@ -0,0 +1,212 @@
+"""
+Converts a SmolLM3 HuggingFace model to Nanotron format.
+
+Command:
+    torchrun --nproc_per_node=1 convert_hf_to_nanotron.py --checkpoint_path=HuggingFaceTB/SmolLM3-3B --save_path=smollm3-nanotron
+"""
+
+import dataclasses
+import json
+from argparse import ArgumentParser
+from pathlib import Path
+
+import nanotron
+import torch
+from nanotron.config import Qwen2Config as NanotronQwen2Config
+from nanotron.models.qwen import Qwen2ForTraining
+from transformers import AutoConfig, AutoModelForCausalLM
+
+try:
+    from transformers import SmolLM3Config as HFSmollm3Config
+    from transformers import SmolLM3ForCausalLM
+except ImportError:
+    HFSmollm3Config = None
+    SmolLM3ForCausalLM = None
+
+try:
+    from .convert_weights import get_config_mapping, get_weight_mapping, load_nanotron_model
+except ImportError:
+    from convert_weights import get_config_mapping, get_weight_mapping, load_nanotron_model
+
+
+def _handle_attention_block(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    n_q_heads: int,
+    n_kv_heads: int,
+    d_qk: int,
+    interleave: bool,
+) -> torch.Tensor:
+    """Concatenates q, k, v weights and applies permutation if rotary embeddings require interleaving."""
+    def interleave_weight(w: torch.Tensor) -> torch.Tensor:
+        w_new = []
+        for head_w in w.split(d_qk):
+            if head_w.dim() == 1:
+                head_w = head_w.view(2, d_qk // 2).transpose(0, 1).reshape(d_qk)
+            else:
+                head_w = head_w.view(2, d_qk // 2, -1).transpose(0, 1).reshape(d_qk, -1)
+            w_new.append(head_w)
+        return torch.cat(w_new)
+
+    q = interleave_weight(q) if interleave else q
+    k = interleave_weight(k) if interleave else k
+    return torch.cat([q, k, v], dim=0)
+
+
+def convert_hf_to_nt(
+    model_hf,
+    model_nt: Qwen2ForTraining,
+    config: NanotronQwen2Config,
+    interleave_qkv: bool = False,
+):
+    """Converts the weights from model_hf to model_nt, making modifications in-place."""
+    hf_sd = model_hf.state_dict()
+    nt_to_hf = get_weight_mapping(config, nt_to_hf=True)
+
+    for module_name_nt, module_nt in model_nt.named_modules():
+        for param_name_nt, param_nt in module_nt.named_parameters(recurse=False):
+            nt_key = f"{module_name_nt}.{param_name_nt}"
+            if nt_key not in nt_to_hf:
+                continue
+
+            hf_target = nt_to_hf[nt_key]
+
+            # In the case of qkv_proj, nt_to_hf maps to [q_proj, k_proj, v_proj]
+            if "qkv_proj" in module_name_nt:
+                if isinstance(hf_target, list):
+                    key_q = next(k for k in hf_target if "q_proj" in k)
+                    key_k = next(k for k in hf_target if "k_proj" in k)
+                    key_v = next(k for k in hf_target if "v_proj" in k)
+                    q = hf_sd[key_q]
+                    k = hf_sd[key_k]
+                    v = hf_sd[key_v]
+                    param = _handle_attention_block(
+                        q,
+                        k,
+                        v,
+                        config.num_attention_heads,
+                        config.num_key_value_heads,
+                        config.hidden_size // config.num_attention_heads,
+                        interleave_qkv,
+                    )
+                else:
+                    param = hf_sd[hf_target]
+
+            # In the case of gate_up_proj, nt_to_hf maps to [gate_proj, up_proj]
+            elif "gate_up_proj" in module_name_nt:
+                if isinstance(hf_target, list):
+                    key_gate = next(k for k in hf_target if "gate_proj" in k)
+                    key_up = next(k for k in hf_target if "up_proj" in k)
+                    gate = hf_sd[key_gate]
+                    up = hf_sd[key_up]
+                    param = torch.cat([gate, up], dim=0)
+                else:
+                    param = hf_sd[hf_target]
+
+            # All other cases are 1-to-1 correspondence
+            else:
+                if isinstance(hf_target, list):
+                    hf_key = hf_target[0]
+                else:
+                    hf_key = hf_target
+
+                # Handle tied embeddings if lm_head is not in state dict
+                if hf_key not in hf_sd and "lm_head" in hf_key and "model.embed_tokens.weight" in hf_sd:
+                    param = hf_sd["model.embed_tokens.weight"]
+                else:
+                    param = hf_sd[hf_key]
+
+            with torch.no_grad():
+                param_nt.copy_(param)
+
+
+def get_nanotron_config(config) -> NanotronQwen2Config:
+    """Converts a HuggingFace SmolLM3 configuration to a Nanotron Qwen2 configuration."""
+    attrs = {
+        nt_key: getattr(config, hf_key)
+        for nt_key, hf_key in get_config_mapping(nt_to_hf=True).items()
+        if hasattr(config, hf_key)
+    }
+
+    if hasattr(config, "sliding_window") and config.sliding_window is not None:
+        if getattr(config, "use_sliding_window", True):
+            attrs["sliding_window_size"] = config.sliding_window
+        else:
+            attrs["sliding_window_size"] = None
+
+    if hasattr(config, "no_rope_layer_interval"):
+        attrs["no_rope_layer"] = config.no_rope_layer_interval
+
+    return NanotronQwen2Config(**attrs)
+
+
+def convert_checkpoint_and_save(
+    checkpoint_path: Path | str,
+    save_path: Path,
+    interleave_qkv: bool = False,
+    device: torch.device = torch.device("cuda" if torch.cuda.is_available() else "cpu"),
+    dtype: torch.dtype = torch.bfloat16,
+):
+    """Loads the HF SmolLM3 checkpoint, initializes a Nanotron model,
+    converts the weights and saves the checkpoint to save_path."""
+    save_path = Path(save_path)
+    save_path.mkdir(parents=True, exist_ok=True)
+
+    print(f"Loading HuggingFace model from {checkpoint_path}...")
+    if SmolLM3ForCausalLM is not None:
+        try:
+            hf_config = HFSmollm3Config.from_pretrained(checkpoint_path)
+            hf_model = SmolLM3ForCausalLM.from_pretrained(checkpoint_path, torch_dtype=dtype)
+        except Exception:
+            hf_config = AutoConfig.from_pretrained(checkpoint_path)
+            hf_model = AutoModelForCausalLM.from_pretrained(checkpoint_path, torch_dtype=dtype)
+    else:
+        hf_config = AutoConfig.from_pretrained(checkpoint_path)
+        hf_model = AutoModelForCausalLM.from_pretrained(checkpoint_path, torch_dtype=dtype)
+
+    print("Initializing Nanotron model...")
+    model_config = get_nanotron_config(hf_config)
+    nanotron_model = load_nanotron_model(model_config=model_config, device=device, dtype=dtype)
+
+    print("Converting weights from HF to Nanotron...")
+    parallel_context = nanotron.parallel.ParallelContext(
+        data_parallel_size=1, pipeline_parallel_size=1, tensor_parallel_size=1
+    )
+    convert_hf_to_nt(hf_model, nanotron_model, model_config, interleave_qkv=interleave_qkv)
+
+    print(f"Saving Nanotron weights to {save_path}...")
+    nanotron.serialize.save_weights(model=nanotron_model, parallel_context=parallel_context, root_folder=save_path)
+
+    with open(save_path / "model_config.json", "w+") as f:
+        json.dump(dataclasses.asdict(model_config), f, indent=2)
+
+    print(f"Model successfully saved to {save_path}")
+
+
+if __name__ == "__main__":
+    parser = ArgumentParser(description="Convert SmolLM3 HF weights to Nanotron format")
+    parser.add_argument(
+        "--checkpoint_path",
+        type=str,
+        default="HuggingFaceTB/SmolLM3-3B",
+        help="Path or HuggingFace repo ID of the HF model",
+    )
+    parser.add_argument(
+        "--save_path",
+        type=Path,
+        default=Path("smollm3-nanotron"),
+        help="Path to save the Nanotron checkpoint",
+    )
+    parser.add_argument(
+        "--interleave_qkv",
+        action="store_true",
+        help="Whether to interleave rotary embedding weights for Q and K",
+    )
+    args = parser.parse_args()
+
+    convert_checkpoint_and_save(
+        checkpoint_path=args.checkpoint_path,
+        save_path=args.save_path,
+        interleave_qkv=args.interleave_qkv,
+    )
